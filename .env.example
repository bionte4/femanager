# Database
DATABASE_URL="postgresql://postgres:password@127.0.0.1:5433/fetrack"

# NextAuth / Auth.js v5
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="change-me-to-a-long-random-secret"
NEXTAUTH_SECRET="change-me-to-a-long-random-secret"

# Mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=""

# MinIO (S3-compatible storage)
MINIO_ENDPOINT="http://localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="ticket-photos"

# WhatsApp Gateway (Fonnte) — bisa di-override di /admin/settings/integrations
FONNTE_TOKEN=""
ADMIN_WHATSAPP=""

# SMTP / Email (opsional — override di Settings UI)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME="FE-Track"

# AI Card KB Chat (OpenAI-compatible — override di Settings UI)
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"

# Cron secret untuk /api/cron/* (wajib di-set; fail-closed)
CRON_SECRET="change-me-cron-secret"

# Webhook monitoring (Zabbix / Uptime Kuma) — Bearer / X-Webhook-Secret
MONITORING_WEBHOOK_SECRET="change-me-monitoring-webhook-secret"

# Stop clock: pause bank ≥ X jam → non-L1 butuh approve L1 (default 2)
STOP_CLOCK_APPROVAL_HOURS="2"

# FCM push (opsional — tanpa ini in-app bell tetap jalan)
FCM_SERVER_KEY=""
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""
